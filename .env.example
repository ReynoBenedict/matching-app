# Salin ke `.env` (Docker Compose) atau `.env.local` (npm run dev). Jangan commit file hasil salinan.

# --- Basis data ---------------------------------------------------------------
# Docker Compose (service `postgres`): host = postgres
DATABASE_URL=postgresql://bps_user:bps_password@postgres:5432/bps_data_matching
# Lokal (npm run dev, Postgres dari compose dipetakan ke port 5432 host):
# DATABASE_URL=postgresql://bps_user:bps_password@localhost:5432/bps_data_matching

# --- Sesi -----------------------------------------------------------------------
# Rahasia penandatanganan cookie sesi (HMAC-SHA256). WAJIB diganti, mis. `openssl rand -hex 32`.
NEXTAUTH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
NEXTAUTH_URL=http://localhost:3000
# Cookie `Secure` hanya dipasang bila NEXTAUTH_URL https:// atau variabel ini `true`.
# SESSION_COOKIE_SECURE=false

# --- Mesin pencocokan -------------------------------------------------------------
# model_service = Model Service FastAPI (disarankan). Kosongkan untuk penyedia
# pengembangan berbasis Levenshtein (hanya untuk development/test).
MATCHING_PROVIDER=model_service
# Docker Compose: http://model:8000 ; lokal: http://localhost:8000
MODEL_SERVICE_URL=http://model:8000
MODEL_SERVICE_TIMEOUT_MS=1800000
# Dibaca oleh Model Service: jumlah tetangga terdekat per record dataset A.
MATCHING_TOP_K=10
